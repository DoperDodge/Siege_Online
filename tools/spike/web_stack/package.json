{
  "name": "redmond-web-spike",
  "private": true,
  "type": "module",
  "description": "PLAN.md §3 tech spike for the browser stack: TypeScript + Three.js + Rapier + Node WebSocket server.",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "vite build && esbuild src/server/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/main.js",
    "start": "node dist-server/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node test/spike-test.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-deterministic-compat": "0.21.0",
    "three": "0.186.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "playwright-core": "1.56.1",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
